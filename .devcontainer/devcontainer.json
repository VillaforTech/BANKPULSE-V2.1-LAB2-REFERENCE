{
  "name": "BankPulse REFERENCE",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    18080,
    13000,
    19090,
    18088
  ],
  "portsAttributes": {
    "18080": {
      "label": "BankPulse Interactive Banking",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "13000": {
      "label": "Grafana",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "19090": {
      "label": "Prometheus",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "18088": {
      "label": "cAdvisor",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-lab.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.exclude": {
          "**/target": true
        }
      }
    }
  },
  "build": {
    "dockerfile": "Dockerfile"
  }
}
